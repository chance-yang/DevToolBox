# Google AdSense publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# Leave the placeholder value below and ads will be disabled.
# After AdSense approval, set this to your real publisher ID.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Optional default ad slot used by <AdBanner /> in tool pages.
# Create the ad unit in AdSense → Ads → By ad unit, then paste its slot ID here.
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_FOOTER=
